@@ -0,0 +1,32 @@
+/** Observe visual readiness without taking ownership of DOM-update diagnostics. */
+export function observeReadyOutcome(transition, ownership) {
+  return transition.ready.then(
+    () => ({ kind: "ready" }),
+    (readyError) => transition.updateCallbackDone.then(
+      () => ownership.isSuperseded() && readyError instanceof DOMException && readyError.name === "AbortError"
+        ? { kind: "superseded", reason: "owned-supersession" }
+        : { kind: "ready-failed", error: readyError },
+      (updateError) => ({ kind: "update-failed", diagnosticOwner: "astro-router", error: updateError }),
+    ),
+  );
+}
+
+/** A narrow owner: callback diagnostics stay with the existing router. */
+export function ownReadyOutcome(transition, ownership, platform) {
+  return observeReadyOutcome(transition, ownership).then((outcome) => {
+    if (outcome.kind === "ready") return;
+    if (outcome.kind === "ready-failed") {
+      platform.reportError(outcome.error);
+      return;
+    }
+    platform.reportOutcome(outcome.kind === "superseded"
+      ? { status: outcome.kind, reason: outcome.reason }
+      : { status: outcome.kind, diagnosticOwner: outcome.diagnosticOwner });
+  }).catch((error) => platform.reportError(error));
+}
+
+/** A failed native skip must not acquire cancellation ownership. */
+export function skipOwnedTransition(transition, ownership) {
+  transition.skipTransition();
+  ownership.markSuperseded();
+}
