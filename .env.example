# Optional canonical production origin, for example https://concept.example.com.
# Leave unset for local/private builds; no canonical URL will be emitted.
PUBLIC_SITE_ORIGIN=

# Optional absolute deployment subpath, for example /gorilla-five-signals.
# Required for GitHub project Pages; omit for root domains and custom domains.
PUBLIC_BASE_PATH=

# Supported values: uz, ru, en.
PUBLIC_DEFAULT_LOCALE=uz

# Supported values: private, public.
# Private emits noindex metadata and a robots.txt disallow rule.
PUBLIC_RELEASE_MODE=private
