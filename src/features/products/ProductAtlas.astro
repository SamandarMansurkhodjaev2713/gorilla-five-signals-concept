---
import type { SupportedLocale } from "@/config/site";
import type { ProductView } from "@/features/site/catalog";
import type { SiteCopy } from "@/features/site/copy";

import { getProductAtlasCopy } from "./product-atlas-copy";
import ProductAtlasHero from "./product-atlas-hero.astro";
import ProductAtlasIndex from "./product-atlas-index.astro";
import type {
  ProductAtlasEntry,
  ProductAtlasViewModel,
} from "./product-atlas-view-model";
import "./product-atlas.css";
import "./product-atlas-decision.css";
import "./product-atlas-stage.css";
import "./product-atlas-chapters.css";
import "./product-atlas-worlds.css";
import "./product-atlas-responsive.css";
import "./product-atlas-mobile.css";
import "./product-atlas-motion.css";

interface Props {
  copy: SiteCopy;
  locale: SupportedLocale;
  products: readonly ProductView[];
}

const EXPECTED_PRODUCT_COUNT = 5;
const INDEX_OFFSET = 1;
const PAD_LENGTH = 2;
const { copy, locale, products } = Astro.props;

if (products.length !== EXPECTED_PRODUCT_COUNT) {
  throw new Error("Product archive requires exactly five approved products.");
}

const atlas: ProductAtlasViewModel = {
  copy,
  locale,
  products,
  text: getProductAtlasCopy(locale),
};
const entries: readonly ProductAtlasEntry[] = products.map(
  (product, index) => ({
    index,
    number: String(index + INDEX_OFFSET).padStart(PAD_LENGTH, "0"),
    product,
  }),
);
---

<article class="product-atlas">
  <ProductAtlasHero atlas={atlas} />
  <ProductAtlasIndex atlas={atlas} entries={entries} />
</article>

<script>
  import { mountProductAtlases } from "@/features/products/product-atlas-controller";

  const atlasController = mountProductAtlases(document);
  document.addEventListener(
    "astro:before-swap",
    (): void => atlasController.destroy(),
    { once: true },
  );
</script>
