---
import type { SupportedLocale } from "@/config/site";
import type { ProductView } from "@/features/site/catalog";
import type { SiteCopy } from "@/features/site/copy";
import { localePath } from "@/features/site/localization";

import { getProductAtlasCopy } from "./product-atlas-copy";
import "./product-atlas.css";
import "./product-atlas-stage.css";
import "./product-atlas-chapters.css";
import "./product-atlas-responsive.css";

interface Props {
  copy: SiteCopy;
  locale: SupportedLocale;
  products: readonly ProductView[];
}

const EXPECTED_PRODUCT_COUNT = 5;
const { copy, locale, products } = Astro.props;
const text = getProductAtlasCopy(locale);

if (products.length !== EXPECTED_PRODUCT_COUNT) {
  throw new Error("Product archive requires exactly five approved products.");
}
---

<article class="product-atlas">
  <header class="archive-hero material-grain">
    <div class="archive-hero__meta" data-motion-reveal>
      <p class="type-label">01—05 / {text.currentRange}</p>
      <p class="type-data">41.2995° N / 69.2401° E</p>
    </div>

    <div class="archive-hero__title" data-motion-reveal>
      <p class="archive-hero__mark" aria-hidden="true">GORILLA</p>
      <h1>
        <span>{text.five}</span>
        <span>{text.frequencies}</span>
      </h1>
    </div>

    <div class="archive-hero__brief" data-motion-copy>
      <p class="type-label">{text.frequencyArchive}</p>
      <p class="type-body-lg">{copy.rangeIntro}</p>
      <p>{text.archiveBrief}</p>
    </div>

    <div class="archive-spectrum" aria-hidden="true">
      {products.map((product) => <span data-flavor={product.slug} />)}
    </div>
  </header>

  <section
    class="archive-index material-grain"
    data-atlas-root
    data-flavor={products[0]?.slug}
    data-selected-label={text.activeFrequency}
    style="--archive-index: 0"
  >
    <aside class="archive-scan" aria-label={text.collectionWall}>
      <div class="archive-scan__sticky">
        <header class="archive-scan__header">
          <div>
            <p class="type-label">02 / {text.collectionWall}</p>
            <p class="type-data">UZ / 01—05 / {text.scan}</p>
          </div>
          <p
            class="archive-scan__status type-data"
            aria-live="polite"
            data-atlas-status
          >
            {text.activeFrequency}: {products[0]?.name} · 01 / 05
          </p>
        </header>

        <nav class="archive-wall" aria-label={copy.chooseSignal} data-atlas-nav>
          {
            products.map((product, index) => (
              <a
                href={`#signal-${product.slug}`}
                id={`archive-link-${product.slug}`}
                data-atlas-link
                data-product-slug={product.slug}
                data-flavor={product.slug}
                aria-current={index === 0 ? "location" : undefined}
              >
                <span class="archive-wall__number">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <span class="archive-wall__can" aria-hidden="true">
                  <img
                    src={product.imagePath}
                    srcset={product.imageSrcSet}
                    sizes="(min-width: 64rem) 10vw, 16vw"
                    width={product.width}
                    height={product.height}
                    alt=""
                    loading={index < 2 ? "eager" : "lazy"}
                    decoding="async"
                  />
                </span>
                <strong>{product.name}</strong>
                <i aria-hidden="true" />
              </a>
            ))
          }
        </nav>

        <div class="archive-scan__readout" aria-hidden="true">
          <span>{text.scrollToScan}</span>
          <span>41°17′58″N / 69°14′24″E</span>
        </div>
      </div>
    </aside>

    <div class="archive-chapters">
      {
        products.map((product, index) => (
          <section
            class="archive-chapter"
            id={`signal-${product.slug}`}
            aria-labelledby={`archive-link-${product.slug}`}
            data-atlas-panel
            data-product-slug={product.slug}
            data-flavor={product.slug}
            data-archive-number={String(index + 1).padStart(2, "0")}
            data-active={index === 0 ? "" : undefined}
            tabindex="-1"
          >
            <div class="archive-chapter__mobile-product">
              <span aria-hidden="true">
                {String(index + 1).padStart(2, "0")}
              </span>
              <img
                src={product.imagePath}
                srcset={product.imageSrcSet}
                sizes="(max-width: 47.99rem) 56vw, 17rem"
                width={product.width}
                height={product.height}
                alt={product.alt}
                loading="lazy"
                decoding="async"
              />
              <div class="archive-chapter__field" aria-hidden="true">
                <>
                  <span />
                  <span />
                  <span />
                  <span />
                </>
              </div>
            </div>

            <div class="archive-chapter__copy">
              <div class="archive-chapter__meta">
                <p class="type-label">
                  {text.chapter} / {String(index + 1).padStart(2, "0")}
                </p>
                <p class="type-data">CH / 0{index + 1}</p>
              </div>
              <p class="archive-chapter__notes">
                {product.flavorNotes.join(" · ")}
              </p>
              <h2>{product.name}</h2>
              <p class="archive-chapter__description">{product.description}</p>
              <div class="archive-chapter__actions">
                <a
                  class="control"
                  href={localePath(locale, `/products/${product.slug}`)}
                >
                  {copy.openDetails}
                </a>
                <a
                  class="text-link"
                  href={`${localePath(locale, "/compare")}?products=${product.slug}`}
                >
                  {copy.navigation.compare} ↗
                </a>
              </div>
              <p class="archive-chapter__warning type-legal">
                {product.warningText}
              </p>
            </div>
          </section>
        ))
      }
    </div>
  </section>

  <footer class="archive-decision">
    <div>
      <p class="type-label">03 / {copy.productTruth}</p>
      <p>{copy.fiveStates}</p>
    </div>
    <div class="archive-decision__actions">
      <a class="control control--primary" href={localePath(locale, "/compare")}>
        {copy.navigation.compare}
      </a>
      <a class="text-link" href={localePath(locale, "/find")}>
        {copy.navigation.find} ↗
      </a>
    </div>
  </footer>
</article>

<script>
  import { mountProductAtlases } from "@/features/products/product-atlas-controller";

  const atlasController = mountProductAtlases(document);
  document.addEventListener(
    "astro:before-swap",
    (): void => atlasController.destroy(),
    { once: true },
  );
</script>
