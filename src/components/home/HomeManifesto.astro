---
import type { SupportedLocale } from "@/config/site";
import type { ProductView } from "@/features/site/catalog";
import type { SiteCopy } from "@/features/site/copy";

import "@/features/home-signal/home-manifesto.css";
import "@/features/home-signal/home-manifesto-responsive.css";

interface Props {
  copy: SiteCopy;
  locale: SupportedLocale;
  products: readonly ProductView[];
}

const { copy, locale, products } = Astro.props;
const lines = {
  en: ["Every can", "keeps its own", "rhythm"],
  ru: ["Каждая банка", "держит свой", "ритм"],
  uz: ["Har bir banka", "o‘z ritmini", "olib keladi"],
}[locale];
const carrier = products.at(0);
const productCount = String(products.length).padStart(2, "0");

if (carrier === undefined) {
  throw new Error("The transmission manifesto requires a carrier product.");
}
---

<section
  class="manifesto material-grain"
  data-motion-scene="range-manifesto"
  data-flavor={carrier.slug}
>
  <span class="manifesto-handoff" aria-hidden="true"></span>

  <div class="manifesto-frame">
    <p class="type-label manifesto-kicker">01 / {copy.rangeLabel}</p>

    <div class="manifesto-carrier" aria-hidden="true">
      <span class="manifesto-carrier__trace"></span>
      <img
        src={carrier.imagePath}
        srcset={carrier.imageSrcSet}
        sizes="(min-width: 64rem) 24rem, 13rem"
        width={carrier.width}
        height={carrier.height}
        alt=""
        loading="lazy"
        decoding="async"
      />
      <span class="manifesto-carrier__echo"></span>
    </div>

    <h2 class="manifesto-thought">
      {
        lines.map((line, index) => (
          <span
            class:list={[
              "manifesto-line",
              { "manifesto-line--signal": index === 1 },
            ]}
            data-manifesto-line
          >
            {line}
          </span>
        ))
      }
    </h2>

    <p class="type-body-lg measure-compact manifesto-intro">
      {copy.rangeIntro}
    </p>

    <div class="manifesto-transmission" aria-hidden="true">
      {products.map((product) => <span data-flavor={product.slug} />)}
      <i></i>
    </div>

    <p
      class="type-label manifesto-output"
      data-motion-signal
      aria-hidden="true"
    >
      <span>SIGNAL CARRIER</span>
      <span>01—{productCount}</span>
    </p>
  </div>
</section>
