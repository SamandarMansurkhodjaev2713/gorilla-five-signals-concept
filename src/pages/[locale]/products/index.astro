---
import type { SupportedLocale } from "@/config/site";
import ProductAtlas from "@/features/products/ProductAtlas.astro";
import { getApprovedProducts } from "@/features/site/catalog";
import { getSiteCopy } from "@/features/site/copy";
import { createLocaleRoutes } from "@/features/site/static-paths";
import SiteLayout from "@/layouts/SiteLayout.astro";

export function getStaticPaths() {
  return createLocaleRoutes();
}

interface Props {
  locale: SupportedLocale;
}

const { locale } = Astro.props;
const copy = getSiteCopy(locale);
const products = await getApprovedProducts(locale);
---

<SiteLayout
  lang={locale}
  title={`${copy.navigation.products} — Gorilla Energy Uzbekistan`}
  description={copy.rangeIntro}
>
  <ProductAtlas copy={copy} locale={locale} products={products} />
</SiteLayout>
