---
import { SUPPORTED_LOCALES, type SupportedLocale } from "@/config/site";
import ProductDetailWorld from "@/features/product-detail/ProductDetailWorld.astro";
import "@/features/product-detail/product-detail-shell.css";
import "@/features/product-detail/product-detail-packshot.css";
import "@/features/product-detail/product-detail-art.css";
import "@/features/product-detail/product-detail-truth.css";
import "@/features/product-detail/product-detail-handoff.css";
import "@/features/product-detail/worlds/original-world.css";
import "@/features/product-detail/worlds/zero-world.css";
import "@/features/product-detail/worlds/extra-world.css";
import "@/features/product-detail/worlds/mango-coconut-world.css";
import "@/features/product-detail/worlds/lychee-pear-world.css";
import "@/features/product-detail/product-detail-responsive.css";
import { getApprovedProducts, type ProductView } from "@/features/site/catalog";
import { getSiteCopy } from "@/features/site/copy";
import SiteLayout from "@/layouts/SiteLayout.astro";

export async function getStaticPaths() {
  const groups = await Promise.all(
    SUPPORTED_LOCALES.map(async (locale) => {
      const products = await getApprovedProducts(locale);
      return products.map((product) => ({
        params: { locale, slug: product.slug },
        props: { locale, product, products },
      }));
    }),
  );
  return groups.flat();
}

interface Props {
  locale: SupportedLocale;
  product: ProductView;
  products: readonly ProductView[];
}

const { locale, product, products } = Astro.props;
const copy = getSiteCopy(locale);
const currentIndex = products.findIndex(({ slug }) => slug === product.slug);
const productNumber = String(currentIndex + 1).padStart(2, "0");
const productCount = String(products.length).padStart(2, "0");
const previousProduct =
  products[(currentIndex - 1 + products.length) % products.length];
const nextProduct = products[(currentIndex + 1) % products.length];

if (previousProduct === undefined || nextProduct === undefined) {
  throw new Error(
    `Product page requirements are incomplete for ${product.slug}.`,
  );
}
---

<SiteLayout
  lang={locale}
  title={product.seoTitle}
  description={product.seoDescription}
>
  <ProductDetailWorld
    {copy}
    {locale}
    {nextProduct}
    {previousProduct}
    {product}
    {productCount}
    {productNumber}
  />
</SiteLayout>
