---
import type { SupportedLocale } from "@/config/site";
import "@/features/contact/contact-switchboard.css";
import { getSiteCopy } from "@/features/site/copy";
import { localePath } from "@/features/site/localization";
import { createLocaleRoutes } from "@/features/site/static-paths";
import SiteLayout from "@/layouts/SiteLayout.astro";

export function getStaticPaths() {
  return createLocaleRoutes();
}

interface Props {
  locale: SupportedLocale;
}

const { locale } = Astro.props;
const copy = getSiteCopy(locale);
const officialWebsite = `https://www.gorillaenergy.uz/?locale=${locale}`;
const content = {
  en: {
    channel: "Contact Gorilla Uzbekistan",
    eyebrow: "Gorilla Uzbekistan",
    note: "Find current contact options on Gorilla Uzbekistan’s official website. This independent concept does not collect messages.",
    official: "Open official website",
    route: "Official Gorilla website",
    topics: [
      "Product information",
      "Retail and distribution",
      "Media",
      "Partnership and event",
      "Privacy or legal",
    ],
  },
  ru: {
    channel: "Связаться с Gorilla Uzbekistan",
    eyebrow: "Gorilla Uzbekistan",
    note: "Актуальные способы связи доступны на официальном сайте Gorilla Uzbekistan. Этот независимый концепт не собирает сообщения.",
    official: "Открыть официальный сайт",
    route: "Официальный сайт Gorilla",
    topics: [
      "Информация о продукте",
      "Розница и дистрибуция",
      "Медиа",
      "Партнёрство и события",
      "Конфиденциальность или право",
    ],
  },
  uz: {
    channel: "Gorilla Uzbekistan bilan bog‘lanish",
    eyebrow: "Gorilla Uzbekistan",
    note: "Amaldagi aloqa usullarini Gorilla Uzbekistan rasmiy saytidan toping. Bu mustaqil konsept xabarlarni yig‘maydi.",
    official: "Rasmiy saytni ochish",
    route: "Gorilla rasmiy sayti",
    topics: [
      "Mahsulot haqida",
      "Chakana savdo va distribyutsiya",
      "Media",
      "Hamkorlik va tadbir",
      "Maxfiylik yoki huquqiy masala",
    ],
  },
}[locale];
---

<SiteLayout
  lang={locale}
  title={`${copy.navigation.contact} — Gorilla Energy Uzbekistan`}
  description={copy.contactIntro}
>
  <article class="contact-switchboard" data-motion-scene="contact-switchboard">
    <header class="switchboard-hero" data-page-lead>
      <div class="switchboard-meta" data-motion-reveal>
        <p class="type-label" data-contact-eyebrow>{content.eyebrow}</p>
        <p class="type-data">TASHKENT / UZ</p>
      </div>
      <h1 data-motion-reveal>{copy.navigation.contact}</h1>
      <p class="type-body-lg" data-motion-reveal>{copy.contactIntro}</p>
      <span class="switchboard-stamp" aria-hidden="true">→ 01—05</span>
    </header>

    <section class="routing-board" aria-labelledby="routing-heading">
      <div class="routing-copy" data-motion-reveal>
        <p class="type-label">01—05 / {content.route}</p>
        <h2 id="routing-heading">{content.channel}</h2>
        <p>{content.note}</p>
      </div>

      <ol class="routing-list">
        {
          content.topics.map((topic, index) => (
            <li>
              <span class="type-data">
                {String(index + 1).padStart(2, "0")}
              </span>
              <strong>{topic}</strong>
              <span
                class="routing-rail"
                data-motion-contact-rail
                aria-hidden="true"
              />
            </li>
          ))
        }
      </ol>

      <div class="routing-endpoint" data-motion-reveal>
        <span class="endpoint-pulse" aria-hidden="true"></span>
        <p class="type-label">{content.route}</p>
        <a
          class="control control--primary"
          data-contact-official
          href={officialWebsite}
          target="_blank"
          rel="noopener noreferrer"
        >
          {content.official} ↗
        </a>
        <a class="text-link" href={localePath(locale, "/legal/privacy")}>
          {copy.legal}
        </a>
      </div>
    </section>

    <footer class="switchboard-close" aria-hidden="true">
      <span>GORILLA</span>
      <span>TASHKENT</span>
      <span>SIGNAL / 05</span>
    </footer>
  </article>
</SiteLayout>
