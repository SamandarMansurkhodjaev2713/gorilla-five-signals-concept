---
import type { SupportedLocale } from "@/config/site";
import { localePath } from "@/features/site/localization";
import { createLocaleRoutes } from "@/features/site/static-paths";
import SiteLayout from "@/layouts/SiteLayout.astro";

export function getStaticPaths() {
  return createLocaleRoutes();
}

interface Props {
  locale: SupportedLocale;
}

const { locale } = Astro.props;
const page = {
  en: {
    action: "Return home",
    body: "The page you requested does not exist or has moved.",
    title: "Signal lost.",
  },
  ru: {
    action: "Вернуться на главную",
    body: "Запрошенная страница не существует или была перемещена.",
    title: "Сигнал потерян.",
  },
  uz: {
    action: "Bosh sahifaga qaytish",
    body: "Siz izlagan sahifa mavjud emas yoki ko‘chirilgan.",
    title: "Signal yo‘qoldi.",
  },
}[locale];
---

<SiteLayout
  lang={locale}
  title={`404 — ${page.title}`}
  description={page.body}
  noIndex
>
  <section class="not-found">
    <p class="type-label">Error / 404</p>
    <h1 class="type-display">{page.title}</h1>
    <p class="type-body-lg">{page.body}</p>
    <a class="control control--primary" href={localePath(locale)}>
      {page.action}
    </a>
  </section>
</SiteLayout>

<style>
  .not-found {
    display: grid;
    min-block-size: calc(100svh - var(--size-header));
    align-content: center;
    gap: var(--space-4);
    padding: var(--space-section) var(--space-gutter);
  }

  .not-found h1 {
    max-inline-size: 10ch;
  }

  .not-found .control {
    justify-self: start;
  }
</style>
